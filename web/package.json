{
  "name": "the-rebuild-web",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run prepare-assets && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "wrangler dev",
    "engine": "python3 scripts/build_engine.py",
    "pyodide": "node scripts/copy_pyodide.mjs",
    "prepare-assets": "pnpm run engine && pnpm run pyodide"
  },
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "private": true,
  "dependencies": {
    "pyodide": "314.0.8"
  }
}
